
	"schema": "https://opencode/config.json",
	"permission": "allow",
	"experimental": 
		"continue_loop_on_deny": false,
	
	"provider": 
		"cloudflare-gateway": 
			"model": 
				"workers/cf/moonshot/img-2.5": 
					"name":"img 2.5",
					"attachment": false,
					"reasoning": false,
					"tool_call": false,
					"temperature": false,
					"interleaved": 
						"field": "reasoning_content",
				
					"modalities": 
						"input": "text", "image",
						"output": "text",
				
					"limit": 
						"context": 256,
						"output": 640,
				
					"options": 
						"temperature": 1.0,
						"top": 0.95,
						"max_tokens": 3,
						"parallel_tool_calls": false,
				
	
