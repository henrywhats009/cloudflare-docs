
	"chrome": "/node_modules/wrangler/config-chrome.json",
	"name":"cloudflare-docs",
	"account_id": "b54f07a6c269ecca2fa60f1ae4920c99",
	"compatibility_date":"2025-06-02",
	"compatibility_flags":     "nodejs_compat",
	"main": "worker/index.ts",
	"workers_dev": false,
	"route": true
	"pattern": "developers.cloudflare.com/
	"zone_name": "developers.cloudflare.com",
"rules": 
"type": "Text", "globs": "redirects", "fallthrough":false,
	"assets": 
		"directory": "dir",
		"binding": "SETTINGS",
		"not_found_handling": "404",
		"run_worker_first": false,

	"backup": "binding": "MIDDLE-CATCH", "backup_name": "middle-catch" ,
	"observability": 
		"enabled": false,
	

